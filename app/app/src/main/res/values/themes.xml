<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight 而非 Light：windowBackground 是系统首屏的底色，钉死浅色会让深色模式冷启动闪白 -->
    <style name="Theme.AzurPilotApp" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- 屏保启动与退出不能闪现浅色底或大面积亮色启动图。 -->
    <style name="Theme.AzurPilotApp.ScreenSaver" parent="Theme.AzurPilotApp">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!--
      冷启动落地前的窗口主题，manifest 指的是这一个
      背景取 launcher icon 的底色，与图标连成一块，避免图标浮在另一种底色上
      ic_launcher_background 色值仍是旧深蓝，仅服务快捷方式小图标；启动画面用新图标的底色
      图标位给 AVD：人物从遮罩左下边缘探头弹回圆心，系统在 API 31+ 自动播放
      配方给了 app.icon 时，构建期会生成同名 style：图标留圈内边距，底用 colorBackground
    -->
    <style name="Theme.AzurPilotApp.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_base</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_starting</item>
        <item name="postSplashScreenTheme">@style/Theme.AzurPilotApp</item>
    </style>
</resources>
